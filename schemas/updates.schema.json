{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosberg.github.io/Fortress-Saga/schemas/updates.schema.json",
  "title": "Updates",
  "type": "object",
  "required": [
    "note",
    "versions"
  ],
  "properties": {
    "versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "version",
          "date",
          "changes",
          "sources"
        ],
        "properties": {
          "version": {
            "type": "string"
          },
          "date": {
            "type": [
              "string",
              "null"
            ]
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "sources": {
            "$ref": "common.schema.json#/$defs/sources"
          }
        }
      }
    }
  }
}

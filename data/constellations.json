{
  "mechanics": [
    { "text": "Constellations unlock at stage 5-10.", "status": "confirmed", "sources": ["gt", "medievalfun"] },
    { "text": "Resetting is free and does not cost Stardust, so you can switch between a boss setup and a farming setup.", "status": "confirmed", "sources": ["gt"] },
    { "text": "Each class unlocks once you have invested enough levels in nebulae: Libra 0, Leonis 15, Aquaril 30, Scorpii 120, Capricornii 160. These are levels, not stars.", "status": "confirmed", "sources": ["hp-constellation"] },
    { "text": "Stardust comes from converting surplus Unique, Epic and Legend heroes on the hero screen.", "status": "confirmed", "sources": ["gt"] },
    { "text": "Each Fortress Expansion tier gives 30 Stardust.", "status": "confirmed", "sources": ["medievalfun", "gt"] },
    { "text": "Cannons and cats at level 100 give some Stardust, but gameplay.tips calls it not worth it. The drafts' figure of 5 is unconfirmed.", "status": "unconfirmed", "sources": ["gt"] }
  ],
